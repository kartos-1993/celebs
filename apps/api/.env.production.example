# API production template. Copy to .env.production (gitignored, never commit)
# and fill every blank. The app refuses to boot in production when wallet,
# courier, or webhook secrets are missing — that is deliberate, not a bug.
NODE_ENV=production
PORT=3000
BASE_PATH=/api/v1
APP_ORIGIN=
COOKIE_DOMAIN=

# PostgreSQL via Supabase pooler. DATABASE_URL must be the :6543 transaction
# pooler (pool max is 4 in production code); DIRECT_URL is the :5432 direct
# connection used only by migrations and Prisma CLI.
DATABASE_URL="postgresql://postgres.[ref]:[pass]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[pass]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Auth — every secret unique to this environment, JWT secrets >= 32 chars.
# Never reuse staging values.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
SESSION_EXPIRES_IN_DAYS=30
SETUP_SECRET=

# Redis (Upstash). REDIS_HOST is the bare hostname, no scheme.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_API_KEY=

# Media (Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET_NAME=celebs
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# Google OAuth
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Push notifications (Expo)
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
EXPO_ACCESS_TOKEN=

# Wallets — LIVE keys only. Callback URLs must be real https; localhost values
# are refused at boot.
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_SUCCESS_URL=
ESEWA_FAILURE_URL=
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://khalti.com
KHALTI_RETURN_URL=
KHALTI_WEBSITE_URL=
APP_PAYMENT_RESULT_URL=celebs://payment-result

# Pathao — LIVE host, merchant dashboard credentials, approved pickup store.
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=

# Fallback courier keys (reserved; adapter is currently a stub).
NCM_API_TOKEN=
NCM_BASE_URL=https://api.nepalcanmove.com/v1

# Platform 1P identity (receipts, invoices) — real corporate details.
PLATFORM_COMPANY_NAME=
PLATFORM_SUPPORT_PHONE=
PLATFORM_TAX_PAN=
PLATFORM_REG_NUMBER=

# Workers & tuning
ORDER_RESERVATION_TTL_HOURS=2
WORKER_CONCURRENCY=5
SLOW_QUERY_THRESHOLD_MS=

# Observability & hosting
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RENDER_EXTERNAL_URL=
RENDER_GIT_COMMIT=
