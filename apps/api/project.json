{
  "name": "api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/api/src/generated/prisma",
            "output": "generated/prisma"
          }
        ]
      },
      "configurations": {
        "development": {
          "declaration": true,
          "declarationMap": true,
          "sourceMap": true
        },
        "production": {
          "declaration": true,
          "declarationMap": false,
          "sourceMap": false
        },
        "staging": {
          "declaration": true,
          "declarationMap": false,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "production",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        },
        "staging": {
          "buildTarget": "api:build:staging"
        }
      }
    },

    "serve:nodemon": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.development -- nodemon --watch apps/api/src --ext ts --exec node -r tsconfig-paths/register -r @swc-node/register apps/api/src/main.ts"
      }
    },

    "migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.development -- npx prisma migrate dev --schema=apps/api/src/db/schema.prisma --name auto"
      }
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.staging -- npx prisma migrate deploy --schema=apps/api/src/db/schema.prisma"
      }
    },
    "studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.development -- npx prisma studio --schema=apps/api/src/db/schema.prisma"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotenv -e apps/api/.env.development -- npx prisma generate --schema=apps/api/src/db/schema.prisma"
      }
    }
  },
  "tags": []
}
