# API Environment Variables Example
PORT=3333
NODE_ENV=development
BASE_PATH=/api/v1
APP_ORIGIN=http://localhost:5173

# Database Connection Strings (PostgreSQL)
# Production/staging: append pool params to avoid connection-queue spikes
# under login bursts, e.g.
#   ?connection_limit=25&pool_timeout=10
DATABASE_URL="postgresql://postgres:celebs@localhost:5432/celebs"
DIRECT_URL="postgresql://postgres:celebs@localhost:5432/celebs"

# Authentication & JWT Secrets (JWT_SECRET must be >= 32 chars)
SETUP_SECRET="replace-me-with-your-own-32-char-secret-0000000000000000"
JWT_SECRET="your_super_secret_jwt_key_here_must_be_at_least_32_chars"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="your_super_secret_refresh_jwt_key_here_must_be_at_least_32_chars"
JWT_REFRESH_EXPIRES_IN=7d
SESSION_EXPIRES_IN_DAYS=30

# Cache & In-Memory Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Media Storage (Cloudflare R2 / AWS S3)
S3_REGION=ap-south-1
S3_BUCKET_NAME=celebs
S3_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:9000/celebs

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@celebs.local

# Google OAuth — set the client ID for each platform you support.
# Get these from: Google Cloud Console > APIs & Services > Credentials.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=

# Sentry error tracking
SENTRY_DSN=your-sentry-dsn

# Wallet payments — eSewa ePay v2 (UAT defaults; override per environment)
# UAT merchant portal test creds: wallets 9806800001-5 / Nepal@123, MPIN 1122, OTP 123456
# NOTE: these static URLs are only a fallback. The mobile app sends its reachable
# origin (callbackBase: LAN IP / tunnel / staging) per checkout, which the API
# allowlists and prefers — so physical phones never get localhost links.
# For same-Wi-Fi device testing, still point these at your dev LAN IP and ensure
# the API binds 0.0.0.0:3333 with inbound 3333 allowed through the firewall.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_SUCCESS_URL=http://localhost:3333/api/v1/orders/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:3333/api/v1/orders/payments/esewa/failure

# Wallet payments — Khalti ePayment v2 (sandbox defaults; keys from test-admin.khalti.com)
# Sandbox test IDs 9800000000-05, MPIN 1111, OTP 987654
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com
KHALTI_RETURN_URL=http://localhost:3333/api/v1/orders/payments/khalti/return
KHALTI_WEBSITE_URL=http://localhost:5173

# Where gateway callbacks redirect the customer after verification (app deep link)
APP_PAYMENT_RESULT_URL=celebs://payment-result
