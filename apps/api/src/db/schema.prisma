datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("userId")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiredAt DateTime @default(dbgenerated("NOW() + interval '30 days'"))

  @@index([userId])
  @@index([expiredAt])
}

enum Role {
  CUSTOMER
  VENDOR
  STAFF
  ADMIN
  SUPERADMIN
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String
  role              Role               @default(CUSTOMER)
  permissions       String[]           @default([])
  isEmailVerified   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userPreferences   UserPreference?    @relation("UserToUserPreference")
  vendorProfile     VendorProfile?     @relation("UserToVendorProfile")
  verificationCodes VerificationCode[]
  sessions          Session[]

  vendorId          String?
  vendor            VendorProfile?     @relation("VendorStaff", fields: [vendorId], references: [id], onDelete: SetNull)
  cart              Cart?
  addresses         Address[]
  orders            Order[]
  reviews           Review[]

  @@index([vendorId])
}

model VendorProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation("UserToVendorProfile", fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber            String   @unique
  shopName               String   @unique
  shopDescription        String?
  panNumber              String   @unique
  citizenshipNumber      String   @unique
  panDocumentUrl         String?
  citizenshipDocumentUrl String?
  ownerPhotoUrl          String?
  payoutDetails          Json?
  status                 String   @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, SUSPENDED
  availableBalance       Decimal  @default(0.00) @db.Decimal(12, 2)
  withholdingEscrow      Decimal  @default(0.00) @db.Decimal(12, 2)
  currencyCode           String   @default("NPR")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Onboarding & Settings
  storeLogo              String?
  businessName           String?
  businessRegNumber      String?
  businessPhoneNumber    String?
  vatDocumentUrl         String?
  businessRegDocumentUrl String?
  holidayMode            Boolean  @default(false)
  onboardingStep         Int      @default(1)
  rejectionReason        String?
  recentCategories       Json?    @default("[]")

  // Relations
  warehouses             Warehouse[]
  staff                  User[]                     @relation("VendorStaff")
  orderItems             OrderItem[]
  products               Product[]
  ownedBrands            Brand[]                    @relation("OwnedBrands")
  brandAuthorizations    VendorBrandAuthorization[]
  mediaFolders           MediaFolder[]
  mediaAssets            MediaAsset[]
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  userId       String
  statusCode   Int
  responseBody String
  createdAt    DateTime @default(now())
  expiresAt    DateTime @default(dbgenerated("NOW() + interval '24 hours'"))

  @@index([key])
}

model UserPreference {
  id                String   @id @default(uuid())
  enable2FA         Boolean  @default(false)
  emailNotification Boolean  @default(true)
  twoFactorSecret   String?
  recentCategories  Json?    @default("[]")
  userId            String   @unique
  user              User     @relation("UserToUserPreference", fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String
  code      String   @unique @default(uuid())
  type      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Warehouse {
  id              String        @id @default(uuid())
  vendorProfileId String
  vendor          VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  label             String
  contactName       String
  contactPhone      String
  addressLine1      String
  addressLine2      String?
  city              String
  district          String
  province          String
  postalCode        String?
  country           String        @default("Nepal")
  isBusinessAddress Boolean       @default(false)
  isReturnAddress   Boolean       @default(false)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  inventories       ProductInventory[]

  @@index([vendorProfileId])
}

model ProductInventory {
  id               String      @id @default(uuid())
  productId        String      @map("product_id")
  colorVariantName String      @map("color_variant_name")
  size             String
  sku              String      @unique
  quantity         Int         @default(0)
  reservedQuantity Int         @default(0) @map("reserved_quantity")
  warehouseId      String?     @map("warehouse_id")
  warehouse        Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  product          Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@unique([productId, colorVariantName, size])
  @@index([productId])
  @@index([productId, quantity])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique @map("user_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique @map("session_id")

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([updatedAt])
}

model CartItem {
  id                 String           @id @default(uuid())
  cartId             String           @map("cart_id")
  cart               Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)

  inventoryId        String           @map("inventory_id")
  inventory          ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  quantity           Int              @default(1)
  comboBundleId      String?          @map("combo_bundle_id")
  comboBundle        ComboBundle?     @relation(fields: [comboBundleId], references: [id], onDelete: SetNull)
  appliedDiscount    Decimal?         @map("applied_discount") @db.Decimal(10, 2)
  discountSource     String?          @map("discount_source")

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([cartId, inventoryId])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  HANDED_OVER
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderItemStatus {
  PENDING
  PACKED
  HANDED_OVER
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
  KHALTI
  ESEWA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Home")
  fullName      String   @map("full_name")
  phone         String
  altPhone      String?  @map("alt_phone")
  province      String
  district      String
  cityArea      String   @map("city_area")
  streetAddress String   @map("street_address")
  landmark      String?
  isDefault     Boolean  @default(false) @map("is_default")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([userId])
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique @map("order_number")
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId      String        @map("address_id")
  address        Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)

  subtotal       Decimal       @db.Decimal(12, 2)
  shippingFee    Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)

  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentId      String?       @map("payment_id")

  items          OrderItem[]
  payments       Payment[]
  trackingEvents OrderTrackingEvent[]

  courierProvider   String?
  courierName       String?
  trackingNumber    String?
  trackingUrl       String?
  dispatchMode      DispatchMode  @default(MANUAL)
  codAmount         Decimal?      @db.Decimal(10, 2)
  codStatus         CodStatus     @default(NOT_APPLICABLE)
  codSettledAt      DateTime?
  codReference      String?
  estimatedDelivery DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([userId, status])
  @@index([status, createdAt])
}

enum DispatchMode {
  MANUAL
  AUTOMATED_3PL
}

enum CodStatus {
  NOT_APPLICABLE
  PENDING_COLLECTION
  COLLECTED_BY_COURIER
  COD_SETTLED
}

model OrderTrackingEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String?
  location    String?
  source      String      @default("SYSTEM")
  timestamp   DateTime    @default(now())

  @@index([orderId])
}

model ComboBundle {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  subtitle      String?
  description   String?
  bannerImage   String?
  discountType  ComboDiscountType @default(PERCENTAGE)
  discountValue Decimal           @db.Decimal(10, 2)
  isFirstParty  Boolean           @default(true)
  isActive      Boolean           @default(true)
  tag           String?
  items         ComboBundleItem[]
  cartItems     CartItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isActive, slug])
}

model ComboBundleItem {
  id              String      @id @default(uuid())
  bundleId        String
  bundle          ComboBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId       String
  defaultQuantity Int         @default(1)
  isRequired      Boolean     @default(true)

  @@unique([bundleId, productId])
  @@index([productId])
}

enum ComboDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Campaign {
  id           String            @id @default(uuid())
  title        String
  slug         String            @unique
  campaignType CampaignType      @default(FESTIVAL)
  tagline      String?
  bannerImage  String?
  themeColor   String            @default("#D92525")
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean           @default(true)
  products     CampaignProduct[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([isActive, startDate, endDate])
}

model CampaignProduct {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([campaignId, productId])
  @@index([productId])
}

enum CampaignType {
  FESTIVAL
  SEASONAL
  FLASH_SALE
  HOLIDAY
  NEW_YEAR
}

model OrderItem {
  id               String           @id @default(uuid())
  orderId          String           @map("order_id")
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  inventoryId      String           @map("inventory_id")
  inventory        ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  vendorId         String           @map("vendor_id")
  vendor           VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  productName      String           @map("product_name")
  colorVariantName String           @map("color_variant_name")
  size             String
  unitPrice        Decimal          @map("unit_price") @db.Decimal(12, 2)
  quantity         Int
  subtotal         Decimal          @db.Decimal(12, 2)

  itemStatus       OrderItemStatus  @default(PENDING) @map("item_status")
  trackingNumber   String?          @map("tracking_number")
  courierPartner   String?          @map("courier_partner")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([inventoryId])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @map("order_id")
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String        @map("user_id")

  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("NPR")
  gateway        PaymentMethod
  transactionId  String?       @unique @map("transaction_id")
  status         PaymentStatus @default(PENDING)
  rawResponse    Json?         @map("raw_response")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {
  id          String       @id @default(uuid())
  aggregate   String       // e.g., "PRODUCT"
  eventType   String       // e.g., "PRODUCT_CATALOG_SYNC"
  payload     Json         // Product payload JSON
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

model StockReservationLedger {
  id          String   @id @default(uuid())
  cartId      String   @map("cart_id")
  userId      String?  @map("user_id")
  sku         String
  quantity    Int
  expiresAt   DateTime @map("expires_at")
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, CONSUMED
  createdAt   DateTime @default(now())

  @@index([sku, status])
  @@index([expiresAt])
}

// ==========================================
// BRAND REGISTRY & PROTECTION ENGINE
// ==========================================

enum BrandTier {
  FIRST_PARTY       // Celebs private label (Celebs Official, Celebs Denim)
  GATED_GLOBAL      // Nike, Adidas, Zara, Levi's (Requires approved LOA)
  REGISTERED_VENDOR // Vendor trademarked brand
  OPEN_GENERIC      // Open to all sellers
}

enum BrandAuthStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model Brand {
  id               String                     @id @default(uuid())
  name             String                     @unique
  slug             String                     @unique
  logoUrl          String?                    @map("logo_url")
  bannerUrl        String?                    @map("banner_url")
  description      String?
  story            String?
  countryOfOrigin  String                     @default("Nepal") @map("country_of_origin")

  tier             BrandTier                  @default(OPEN_GENERIC)
  isGated          Boolean                    @default(false) @map("is_gated")

  ownerVendorId    String?                    @map("owner_vendor_id")
  ownerVendor      VendorProfile?             @relation("OwnedBrands", fields: [ownerVendorId], references: [id], onDelete: SetNull)

  products         Product[]
  authorizations   VendorBrandAuthorization[]
  protectionRules  BrandProtectionRule[]

  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([tier, isGated])
  @@index([ownerVendorId])
}

model VendorBrandAuthorization {
  id                 String          @id @default(uuid())
  vendorId           String          @map("vendor_id")
  vendor             VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  brandId            String          @map("brand_id")
  brand              Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)

  status             BrandAuthStatus @default(PENDING)
  documentType       String          @map("document_type") // LOA, TRADEMARK_CERT, INVOICE, DEALERSHIP_CONTRACT
  documentUrl        String          @map("document_url")
  documentExpiryDate DateTime?       @map("document_expiry_date")

  reviewedBy         String?         @map("reviewed_by")
  reviewedAt         DateTime?       @map("reviewed_at")
  reviewNotes        String?         @map("review_notes")
  rejectionReason    String?         @map("rejection_reason")

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([vendorId, brandId])
  @@index([vendorId, status])
  @@index([brandId, status])
}

model BrandProtectionRule {
  id          String   @id @default(uuid())
  brandId     String   @map("brand_id")
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  pattern     String   // Regex pattern for anti-hijack screening
  matchField  String   @default("TITLE_AND_DESCRIPTION") @map("match_field")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId, isActive])
}

// ==========================================
// MULTI-VENDOR DIGITAL ASSET MANAGEMENT (DAM)
// ==========================================

enum MediaScope {
  PRODUCT
  BRANDING
  KYC
  MARKETING
}

model MediaFolder {
  id          String         @id @default(uuid())
  vendorId    String?        @map("vendor_id")
  vendor      VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  parentId    String?        @map("parent_id")
  parent      MediaFolder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFolders  MediaFolder[]  @relation("FolderHierarchy")

  assets      MediaAsset[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([vendorId, parentId, name])
  @@index([vendorId])
}

model MediaAsset {
  id           String         @id @default(uuid())
  vendorId     String?        @map("vendor_id")
  vendor       VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  folderId     String?        @map("folder_id")
  folder       MediaFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  originalName String         @map("original_name")
  key          String         @unique
  url          String

  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  width        Int?
  height       Int?
  aspectRatio  Float?         @map("aspect_ratio")
  hashSha256   String?        @map("hash_sha256")

  scope        MediaScope     @default(PRODUCT)
  isPrivate    Boolean        @default(false) @map("is_private")
  usageCount   Int            @default(0) @map("usage_count")

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([vendorId, scope])
  @@index([vendorId, folderId])
  @@index([vendorId, hashSha256])
  @@index([vendorId, createdAt])
}

// ==========================================
// PRODUCT CATALOG
// ==========================================

model Product {
  id                      String             @id @default(uuid())
  name                    String
  brand                   String?
  brandId                 String?
  brandRef                Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  slug                    String             @unique
  description             String?            @default("")
  price                   Decimal            @db.Decimal(12, 2)
  discountedPrice         Decimal?           @db.Decimal(12, 2)
  status                  String             @default("draft") // draft, pending_review, published, rejected, deactivated, archived
  featured                Boolean            @default(false)
  mainImages              String[]
  tags                    String[]

  // Flexible Document JSONB Fields
  sizes                   Json?              // Array of ISize (productMeasurements + bodyMeasurements)
  colorVariants           Json?              // Array of IColorVariant
  skus                    Json?              // Array of ISkuItem
  variantOptions          Json?              // Array of IVariantOption
  dynamicData             Json?              // Category dynamic attribute values

  // Moderation & QC
  qualityScore            Float?
  reviewNote              String?
  rejectionReasonCategory String?
  rejectionSubcategories String[]
  rejectionFields        String[]
  reviewHistory           Json?
  reviewedBy              String?
  reviewedAt              DateTime?
  createdBy               String?
  updatedBy               String?

  // Relational Foreign Keys
  vendorId                String?
  vendorName              String?
  vendor                  VendorProfile?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  categoryId              String
  category                Category           @relation("CategoryProducts", fields: [categoryId], references: [id])
  subcategoryId           String?
  subcategory             Category?          @relation("SubcategoryProducts", fields: [subcategoryId], references: [id], onDelete: SetNull)

  inventories             ProductInventory[]
  reviews                 Review[]

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([vendorId])
  @@index([brandId])
  @@index([status])
  @@index([categoryId, status])
  @@index([status, createdAt])
}

model Category {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  path             String?
  level            Int         @default(0)
  parentCategory   String?
  parent           Category?   @relation("ParentChildCategory", fields: [parentCategory], references: [id], onDelete: SetNull)
  children         Category[]  @relation("ParentChildCategory")

  attributes       Json?       // Array of CategoryAttribute objects
  sizeChartColumns String[]
  bodyChartColumns String[]    @default([])
  imageUrl         String?
  isActive         Boolean     @default(true)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  products         Product[]   @relation("CategoryProducts")
  subProducts      Product[]   @relation("SubcategoryProducts")

  @@index([slug])
  @@index([parentCategory])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String?
  rating    Int
  comment   String?
  images    String[]
  status    String   @default("pending") // pending, approved, rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model OptionSet {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?
  description String?
  options     Json     // Array of option items { label, value, meta }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuickFilter {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  categoryId   String?
  filterConfig Json

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  targetUrl String?
  position  String   @default("home_hero")
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// DYNAMIC PLATFORM CONFIGURATION & FEATURE FLAGS
// ==========================================

enum SettingType {
  BOOLEAN
  NUMBER
  STRING
  JSON
}

model PlatformSetting {
  key          String      @id
  value        String
  type         SettingType @default(BOOLEAN)
  group        String      @default("GENERAL")
  label        String
  description  String?
  isPublic     Boolean     @default(false) @map("is_public")

  updatedBy    String?     @map("updated_by")
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  auditLogs    PlatformSettingAudit[]

  @@index([group])
  @@index([isPublic])
}

model PlatformSettingAudit {
  id           String          @id @default(uuid())
  settingKey   String          @map("setting_key")
  setting      PlatformSetting @relation(fields: [settingKey], references: [key], onDelete: Cascade)

  oldValue     String?         @map("old_value")
  newValue     String          @map("new_value")
  changedBy    String          @map("changed_by")
  reason       String?

  createdAt    DateTime        @default(now())

  @@index([settingKey, createdAt])
}

