datasource db {
  provider  = "postgresql"
}


generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}


model Session {
  id        String   @id @default(uuid())
  userId    String   @map("userId")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiredAt DateTime @default(dbgenerated("NOW() + interval '30 days'"))

  @@index([userId])
}

enum Role {
  CUSTOMER
  VENDOR
  STAFF
  ADMIN
  SUPERADMIN
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(CUSTOMER)
  isEmailVerified Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userPreferences UserPreference?  @relation("UserToUserPreference")
  vendorProfile   VendorProfile?   @relation("UserToVendorProfile")
  verificationCodes VerificationCode[]
  sessions        Session[]

  vendorId        String?
  vendor          VendorProfile?   @relation("VendorStaff", fields: [vendorId], references: [id], onDelete: SetNull)
  cart            Cart?
  addresses       Address[]
  orders          Order[]

  @@index([vendorId])
}

model VendorProfile {
  id                     String   @id @default(dbgenerated("gen_random_uuid()"))
  userId                 String   @unique
  user                   User     @relation("UserToVendorProfile", fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber            String   @unique
  shopName               String   @unique
  shopDescription        String?
  panNumber              String   @unique
  citizenshipNumber      String   @unique
  panDocumentUrl         String?
  citizenshipDocumentUrl String?
  ownerPhotoUrl          String?
  payoutDetails          Json?
  status                 String   @default("PENDING") // PENDING, APPROVED, SUSPENDED, REJECTED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Onboarding & Settings
  storeLogo              String?
  businessName           String?
  businessRegNumber      String?
  businessPhoneNumber    String?
  vatDocumentUrl         String?
  businessRegDocumentUrl String?
  holidayMode            Boolean  @default(false)
  onboardingStep         Int      @default(1)

  // Relations
  warehouses             Warehouse[]
  staff                  User[]   @relation("VendorStaff")
  orderItems             OrderItem[]
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  key          String   @unique
  userId       String
  statusCode   Int
  responseBody String
  createdAt    DateTime @default(now())
  expiresAt    DateTime @default(dbgenerated("NOW() + interval '24 hours'"))

  @@index([key])
}

model UserPreference {
  id              String  @id @default(dbgenerated("gen_random_uuid()"))
  enable2FA       Boolean @default(false)
  emailNotification Boolean @default(true)
  twoFactorSecret String?
  userId          String  @unique
  user            User    @relation("UserToUserPreference", fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  code      String   @unique @default(dbgenerated("gen_random_uuid()"))
  type      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Warehouse {
  id              String        @id @default(dbgenerated("gen_random_uuid()"))
  vendorProfileId String
  vendor          VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)

  label             String
  contactName       String
  contactPhone      String
  addressLine1      String
  addressLine2      String?
  city              String
  district          String
  province          String
  postalCode        String?
  country           String        @default("Nepal")
  isBusinessAddress Boolean       @default(false)
  isReturnAddress   Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  inventories     ProductInventory[]

  @@index([vendorProfileId])
}

model ProductInventory {
  id               String      @id @default(dbgenerated("gen_random_uuid()"))
  productId        String      @map("product_id")
  colorVariantName String      @map("color_variant_name")
  size             String
  sku              String      @unique
  quantity         Int         @default(0)
  reservedQuantity Int         @default(0) @map("reserved_quantity")
  warehouseId      String?     @map("warehouse_id")
  warehouse        Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@unique([productId, colorVariantName, size])
  @@index([productId])
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()"))
  userId    String?    @unique @map("user_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique @map("session_id")

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()"))
  cartId             String           @map("cart_id")
  cart               Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)

  inventoryId        String           @map("inventory_id")
  inventory          ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  quantity           Int              @default(1)
  comboBundleId      String?          @map("combo_bundle_id")
  comboBundle        ComboBundle?     @relation(fields: [comboBundleId], references: [id], onDelete: SetNull)
  appliedDiscount    Decimal?         @map("applied_discount") @db.Decimal(10, 2)
  discountSource     String?          @map("discount_source")

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([cartId, inventoryId])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  HANDED_OVER
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderItemStatus {
  PENDING
  PACKED
  HANDED_OVER
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
  KHALTI
  ESEWA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Home")
  fullName      String   @map("full_name")
  phone         String
  altPhone      String?  @map("alt_phone")
  province      String
  district      String
  cityArea      String   @map("city_area")
  streetAddress String   @map("street_address")
  landmark      String?
  isDefault     Boolean  @default(false) @map("is_default")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([userId])
}

model Order {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  orderNumber    String        @unique @map("order_number")
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  addressId      String        @map("address_id")
  address        Address       @relation(fields: [addressId], references: [id], onDelete: Restrict)

  subtotal       Decimal       @db.Decimal(12, 2)
  shippingFee    Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)

  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod  PaymentMethod @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentId      String?       @map("payment_id")

  items          OrderItem[]
  payments       Payment[]
  trackingEvents OrderTrackingEvent[]

  courierProvider   String?
  courierName       String?
  trackingNumber    String?
  trackingUrl       String?
  dispatchMode      DispatchMode  @default(MANUAL)
  codAmount         Decimal?      @db.Decimal(10, 2)
  codStatus         CodStatus     @default(NOT_APPLICABLE)
  codSettledAt      DateTime?
  codReference      String?
  estimatedDelivery DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

enum DispatchMode {
  MANUAL
  AUTOMATED_3PL
}

enum CodStatus {
  NOT_APPLICABLE
  PENDING_COLLECTION
  COLLECTED_BY_COURIER
  COD_SETTLED
}

model OrderTrackingEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String?
  location    String?
  source      String      @default("SYSTEM")
  timestamp   DateTime    @default(now())

  @@index([orderId])
}

model ComboBundle {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  subtitle      String?
  description   String?
  bannerImage   String?
  discountType  ComboDiscountType @default(PERCENTAGE)
  discountValue Decimal           @db.Decimal(10, 2)
  isFirstParty  Boolean           @default(true)
  isActive      Boolean           @default(true)
  tag           String?
  items         ComboBundleItem[]
  cartItems     CartItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isActive, slug])
}

model ComboBundleItem {
  id              String      @id @default(uuid())
  bundleId        String
  bundle          ComboBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId       String
  defaultQuantity Int         @default(1)
  isRequired      Boolean     @default(true)

  @@unique([bundleId, productId])
  @@index([productId])
}

enum ComboDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Campaign {
  id           String            @id @default(uuid())
  title        String
  slug         String            @unique
  campaignType CampaignType      @default(FESTIVAL)
  tagline      String?
  bannerImage  String?
  themeColor   String            @default("#D92525")
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean           @default(true)
  products     CampaignProduct[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([isActive, startDate, endDate])
}

model CampaignProduct {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([campaignId, productId])
  @@index([productId])
}

enum CampaignType {
  FESTIVAL
  SEASONAL
  FLASH_SALE
  HOLIDAY
  NEW_YEAR
}

model OrderItem {
  id               String           @id @default(dbgenerated("gen_random_uuid()"))
  orderId          String           @map("order_id")
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  inventoryId      String           @map("inventory_id")
  inventory        ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  vendorId         String           @map("vendor_id")
  vendor           VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  productName      String           @map("product_name")
  colorVariantName String           @map("color_variant_name")
  size             String
  unitPrice        Decimal          @map("unit_price") @db.Decimal(12, 2)
  quantity         Int
  subtotal         Decimal          @db.Decimal(12, 2)

  itemStatus       OrderItemStatus  @default(PENDING) @map("item_status")
  trackingNumber   String?          @map("tracking_number")
  courierPartner   String?          @map("courier_partner")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([inventoryId])
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()"))
  orderId        String        @map("order_id")
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String        @map("user_id")

  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("NPR")
  gateway        PaymentMethod
  transactionId  String?       @unique @map("transaction_id")
  status         PaymentStatus @default(PENDING)
  rawResponse    Json?         @map("raw_response")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
}


