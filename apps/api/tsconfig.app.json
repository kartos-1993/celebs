{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "../../",
    "outDir": "../../dist/out-tsc",
    "rootDir": "../../",
    "module": "commonjs",
    "types": ["node", "express", "multer"],
    "paths": {
      "@/*": ["apps/api/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/__tests__/setup.ts"]
}
