{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node", "express", "multer"],
    "baseUrl": ".",
    "paths": {
      "@celebs/rbac": ["../../packages/rbac/src/index.ts"],
      "@celebs/shared-utils": ["../../packages/shared-utils/src/index.ts"],
      "@celebs/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/__tests__/setup.ts"]
}
