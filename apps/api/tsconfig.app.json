{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "../../",
    "outDir": "../../dist/out-tsc",
    "rootDir": "../../",
    "module": "commonjs",
    "types": ["node", "express"],
    "paths": {
      "@/*": ["apps/api/src/*"],
      "@celebs/rbac": ["packages/rbac/src/index.ts"],
      "@celebs/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@celebs/shared-types": ["packages/shared-types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/__tests__/setup.ts"]
}
