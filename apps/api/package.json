{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "//_DEVELOPMENT": "=== Local Development ===",
    "dev": "dotenv -e .env.development -- nodemon --watch src --ext ts --exec node -r tsconfig-paths/register -r @swc-node/register src/main.ts",
    "dev:staging": "dotenv -e .env.staging -- nodemon --watch src --ext ts --exec node -r tsconfig-paths/register -r @swc-node/register src/main.ts",
    "dev:worker": "dotenv -e .env.development -- nodemon --watch src --ext ts --exec node -r tsconfig-paths/register -r @swc-node/register src/worker-main.ts",
    "//_BUILD_AND_SERVE": "=== Build & Serve ===",
    "build": "tsc -p tsconfig.app.json && npx tsc-alias -p tsconfig.app.json",
    "start": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/api/src/worker-main.js",
    "//_DATABASE_AND_PRISMA": "=== Database & Prisma ORM ===",
    "prisma:generate": "dotenv -e .env.development -- npx prisma generate --schema=src/db/schema.prisma --config=../../prisma.config.ts",
    "db:push": "dotenv -e .env.development -- npx prisma db push --schema=src/db/schema.prisma --config=../../prisma.config.ts",
    "db:push:staging": "dotenv -e .env.staging -- npx prisma db push --schema=src/db/schema.prisma --config=../../prisma.config.ts",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev --schema=src/db/schema.prisma --config=../../prisma.config.ts",
    "prisma:migrate:staging": "dotenv -e .env.staging -- npx prisma db push --schema=src/db/schema.prisma --config=../../prisma.config.ts",
    "prisma:studio": "dotenv -e .env.development -- npx prisma studio --schema=src/db/schema.prisma --config=../../prisma.config.ts",
    "//_SEEDING": "=== Database Seeding ===",
    "seed": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/index.ts",
    "seed:reset": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/index.ts --reset",
    "seed:staging": "dotenv -e .env.staging -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/index.ts",
    "seed:staging:reset": "dotenv -e .env.staging -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/index.ts --reset",
    "seed:option-sets": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/seed-option-sets.ts",
    "seed:categories-men": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/seed-categories-men.ts",
    "seed:categories-jewelry": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/seed-categories-jewelry.ts",
    "seed:products-denim-jackets": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/seed-products-denim-jackets.ts",
    "seed:products-denim-jeans": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/seed-products-denim-jeans.ts",
    "seed:products-mock": "dotenv -e .env.development -- node -r tsconfig-paths/register -r @swc-node/register src/db/seed/seed-products-mock-catalog.ts",
    "//_QUALITY": "=== Code Quality & Testing ===",
    "test": "dotenv -e .env.test -- prisma db push --schema=src/db/schema.prisma --accept-data-loss --config=../../prisma.config.ts && dotenv -e .env.test -- vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@celebs/rbac": "workspace:*",
    "@celebs/shared-types": "workspace:*",
    "@celebs/shared-utils": "workspace:*",
    "@upstash/redis": "^1.38.2",
    "bullmq": "^5.41.0",
    "ioredis": "^5.11.1",
    "multer": "^2.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/multer": "^1.4.12",
    "tsc-alias": "^1.9.0"
  }
}
