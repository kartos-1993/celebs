{
  "extends": "../../packages/tsconfig/tsconfig.vite.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@celebs/rbac": ["../../packages/rbac/src/index.ts"],
      "@celebs/shared-utils": ["../../packages/shared-utils/src/index.ts"],
      "@celebs/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@celebs/shared-ui": ["../../packages/shared-ui/src"],
      "@celebs/shared-ui/*": ["../../packages/shared-ui/src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/__tests__/*",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
