{
  "name": "web-admin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-admin/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{workspaceRoot}/dist/apps/web-admin"],
      "defaultConfiguration": "production",
      "options": {
        "configFile": "apps/web-admin/vite.config.ts",
        "outputPath": "dist/apps/web-admin"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "staging": {
          "mode": "staging"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web-admin:build",
        "hmr": true
      },
      "configurations": {
        "development": {
          "buildTarget": "web-admin:build:development",
          "hmr": true,
          "mode": "development"
        },
        "staging": {
          "buildTarget": "web-admin:build:staging",
          "hmr": true,
          "mode": "staging"
        },
        "production": {
          "buildTarget": "web-admin:build:production",
          "hmr": false,
          "mode": "production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "web-admin:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "web-admin:build:development"
        },
        "staging": {
          "buildTarget": "web-admin:build:staging"
        },
        "production": {
          "buildTarget": "web-admin:build:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --mode staging && netlify deploy --dir=../../dist/apps/web-admin --prod",
        "cwd": "apps/web-admin"
      },
      "configurations": {
        "staging": {
          "command": "vite build --mode staging && netlify deploy --dir=../../dist/apps/web-admin --alias=staging"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/web-admin"
      }
    },

    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/web-admin/**/*.{ts,tsx,js,jsx}"],
        "cache": true
      }
    }
  },
  "tags": ["frontend", "react", "vite"]
}
