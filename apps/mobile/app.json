{
  "expo": {
    "name": "celebs",
    "slug": "celebs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "celebs",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.celebs.app",
      "buildNumber": "1",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.celebs.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a54d402-6501-43f8-b834-c690e2e49a71"
      }
    }
  }
}
