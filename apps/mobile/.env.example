# Mobile Application Environment Variables Template
# Copy this template to .env.development or .env.staging

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3333/api/v1
EXPO_PUBLIC_USE_LOCAL_API=true
EXPO_PUBLIC_MEDIA_URL=https://media.celebs.com.np
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Sentry error tracking
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
