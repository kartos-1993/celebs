# ==============================================================================
# Production Environment Configuration for Self-Hosted Celebs Stack
# Copy to .env.production on the server and populate secrets
# ==============================================================================

NODE_ENV=production
PORT=3000

# ─── DATABASE (PostgreSQL 15 Container) ──────────────────────────────────────
# Connect to container name 'postgres' on the internal celebs-net Docker network
POSTGRES_USER=celebs_admin
POSTGRES_PASSWORD=ReplaceWithStrongDbPassword!
POSTGRES_DB=celebs_prod

DATABASE_URL="postgresql://celebs_admin:ReplaceWithStrongDbPassword!@postgres:5432/celebs_prod?schema=public&connection_limit=20"
DIRECT_URL="postgresql://celebs_admin:ReplaceWithStrongDbPassword!@postgres:5432/celebs_prod?schema=public"

# ─── CACHE & QUEUES (Redis 7 Container) ───────────────────────────────────────
# Connect to container name 'redis' on the internal celebs-net Docker network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ReplaceWithStrongRedisPassword!
REDIS_URL="redis://:ReplaceWithStrongRedisPassword!@redis:6379"

# ─── OBJECT STORAGE (MinIO S3 Container) ─────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ReplaceWithStrongMinioPassword!

S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_BUCKET="celebs-media"
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=ReplaceWithStrongMinioPassword!
S3_FORCE_PATH_STYLE=true

# ─── MONITORING AUTH (Grafana Container) ──────────────────────────────────────
GRAFANA_PASSWORD=ReplaceWithStrongGrafanaAdminPassword!

# ─── APPLICATION SECRETS ─────────────────────────────────────────────────────
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_character_hex_string_here
SESSION_SECRET=replace_with_another_random_64_character_hex_string_here

# Optional: external URL for keepalive ping (if applicable)
RENDER_EXTERNAL_URL=""

# Optional: Error tracking
# SENTRY_DSN=""
